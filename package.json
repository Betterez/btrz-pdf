{
  "name": "btrz-pdf",
  "version": "4.0.0",
  "description": "Generates pdf documents based on a liquid template",
  "main": "src/index.js",
  "scripts": {
    "tdd": "node --watch --test test/*.js",
    "test": "node --test test/*.js",
    "preversion": "npm test",
    "postversion": "git push origin main && git push --tags",
    "version": "git tag $1",
    "prepare": "git config core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Betterez/btrz-pdf.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Betterez/btrz-pdf/issues"
  },
  "homepage": "https://github.com/Betterez/btrz-pdf#readme",
  "dependencies": {
    "@foliojs-fork/linebreak": "1.1.2",
    "@foliojs-fork/pdfkit": "0.15.3",
    "@rkusa/linebreak": "1.0.0",
    "btrz-liquid-templates": "2.0.1",
    "inherits": "2.0.4",
    "opentype.js": "2.0.0",
    "pako": "3.0.0",
    "readable-stream": "4.7.0",
    "svg-to-pdfkit": "0.1.8",
    "unorm": "1.6.0",
    "util-deprecate": "1.0.2",
    "uuid": "14.0.1",
    "written-number": "0.11.1",
    "xmldoc": "3.0.0"
  },
  "devDependencies": {}
}
